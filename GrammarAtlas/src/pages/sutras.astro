---
import Layout from '../layouts/Layout.astro';
import SutraListControls from '../components/SutraListControls';
import { getAllSutras } from '../utils/getSutras';

const sutraList = await getAllSutras();
---

<Layout title="经文列表">
  <SutraListControls client:load initialSutras={sutraList} />
</Layout>
